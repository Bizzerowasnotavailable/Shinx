<Project Sdk="Cosmos.Sdk/3.0.66">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <CosmosEnableInterrupts>true</CosmosEnableInterrupts>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableStorage>true</CosmosEnableStorage>
    <CosmosEnableNetwork>true</CosmosEnableNetwork>
    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableKeyboard>true</CosmosEnableKeyboard>
    <CosmosEnableMouse>true</CosmosEnableMouse>
    <CosmosEnableTimer>true</CosmosEnableTimer>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>

    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>false</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.66" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.66" />
    <PackageReference Include="Cosmos.Kernel.HAL.Interfaces" Version="3.0.66" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LuaUtils\**\*.lua">
      <LogicalName>Shinx.LuaUtils.%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <GCCProject Include="./src/C/" />
  </ItemGroup>

</Project>